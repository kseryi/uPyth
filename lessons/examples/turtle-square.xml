<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="flag_start" x="20" y="20">
    <next>
  <block type="import_turtle">
    <next>
      <block type="create_turtle">
        <field name="NAME">t</field>
        <next>
          <block type="set_speed">
            <field name="NAME">t</field>
            <value name="SPEED"><shadow type="math_number"><field name="NUM">8</field></shadow></value>
            <next>
              <block type="t_color">
                <value name="COLOR"><shadow type="text"><field name="TEXT">blue</field></shadow></value>
                <next>
                  <block type="controls_repeat_ext">
                    <value name="TIMES"><shadow type="math_number"><field name="NUM">4</field></shadow></value>
                    <statement name="DO">
                      <block type="t_forward">
                        <value name="DIST"><shadow type="math_number"><field name="NUM">120</field></shadow></value>
                        <next>
                          <block type="t_right">
                            <value name="ANGLE"><shadow type="math_number"><field name="NUM">90</field></shadow></value>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <next>
                      <block type="print">
                        <value name="VALUE"><shadow type="text"><field name="TEXT">Готово!</field></shadow></value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
    </next>
  </block>
</xml>
